# Copy to .env for local dev. Every value is optional: with none set, the app runs on an
# embedded Postgres (PGlite) with a seeded demo community, offline film catalog and
# taste-match recommendations.

# --- Database -------------------------------------------------------------
# Any PostgreSQL URL (Neon, Supabase, RDS, local). Unset = embedded PGlite in .data/pglite.
# On Netlify without it, the API runs a per-instance in-memory sandbox (demo data, writes don't persist).
DATABASE_URL=
# Set to "false" to skip seeding the six demo players on an empty database.
SEED_DEMO=true

# --- Film data (TMDB) -------------------------------------------------------
# Server-side only; never prefix with VITE_. Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Local convenience when you have no key: forward TMDB requests to an existing deployment of this app's proxy.
# TMDB_UPSTREAM=https://cinemaverse-solo.netlify.app

# --- AI recommendations (OpenRouter) ----------------------------------------
# Without a key, "For you" uses the built-in taste-match engine and says so.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
PUBLIC_SITE_URL=https://cinemaverse-solo.netlify.app

# --- Roles -----------------------------------------------------------------
# Comma-separated emails that get the admin role at sign-up (can delete any feed post).
ADMIN_EMAILS=
